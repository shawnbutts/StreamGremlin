{
  "schema": "streamgremlin.workflow/v1",
  "id": "chat.hello",
  "name": "Say hello back",
  "description": "Answers !hello in chat, by name.",
  "triggers": [{ "type": "chat.command.received", "where": { "command": "hello" } }],
  "queue": { "policy": "drop" },
  "steps": [
    { "action": "chat.send", "with": { "message": "Hi ${event.actor.display_name}! 👋" } }
  ]
}

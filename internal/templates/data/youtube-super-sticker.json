{
  "template": {
    "id": "youtube-super-sticker",
    "title": "Thank Super Stickers, with an alert",
    "category": "YouTube events",
    "description": "Shows an alert with the sticker and amount, and says thanks in YouTube chat. Add an overlay on the Overlays screen first.",
    "starter": false,
    "blanks": [
      {
        "path": "$.steps[0].with.overlay",
        "hint": "Your alert overlay's name, like alerts"
      }
    ]
  },
  "workflow": {
    "schema": "streamgremlin.workflow/v1",
    "id": "youtube.super-sticker",
    "name": "Thank Super Stickers",
    "group": "Thanks",
    "triggers": [
      {
        "type": "monetization.super_sticker.received"
      }
    ],
    "steps": [
      {
        "action": "overlays.alert",
        "with": {
          "overlay": "",
          "title": "Super Sticker",
          "text": "${event.payload.from} sent ${event.payload.sticker} (${event.payload.amount_display})",
          "picture": true
        }
      },
      {
        "action": "chat.send",
        "with": {
          "message": "Thanks for the Super Sticker, ${event.payload.from}! 💛"
        }
      }
    ]
  }
}

{
  "template": {
    "id": "youtube-member",
    "title": "Welcome new YouTube members, with an alert",
    "category": "YouTube events",
    "description": "Shows an alert when someone becomes a member of your YouTube channel, and welcomes them in YouTube chat. Gifted memberships have their own template. Add an overlay on the Overlays screen first.",
    "starter": false,
    "blanks": [
      {
        "path": "$.steps[0].with.overlay",
        "hint": "Your alert overlay's name, like alerts"
      }
    ]
  },
  "workflow": {
    "schema": "streamgremlin.workflow/v1",
    "id": "youtube.member",
    "name": "Welcome new members",
    "group": "Thanks",
    "triggers": [
      {
        "type": "monetization.subscription.started",
        "sources": [
          "youtube"
        ],
        "where": {
          "is_gift": false
        }
      }
    ],
    "steps": [
      {
        "action": "overlays.alert",
        "with": {
          "overlay": "",
          "title": "New member",
          "text": "${event.actor.display_name} joined as ${event.payload.?level.orValue(\"\") != \"\" ? event.payload.level : \"a member\"}!",
          "picture": true
        }
      },
      {
        "action": "chat.send",
        "with": {
          "message": "Welcome to the members, ${event.actor.display_name}! 🎉"
        }
      }
    ]
  }
}

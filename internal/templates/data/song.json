{
  "template": {
    "id": "song",
    "title": "Song",
    "category": "Chat commands",
    "description": "!song says what Pretzel is playing, with Pretzel's link to the song. Pretzel's own chat attribution still posts as Pretzel requires.",
    "starter": false,
    "blanks": []
  },
  "workflow": {
    "schema": "streamgremlin.workflow/v1",
    "id": "chat.song",
    "name": "Song",
    "group": "Commands",
    "triggers": [
      {
        "type": "chat.command.received",
        "where": {
          "command": "song"
        }
      }
    ],
    "queue": {
      "policy": "drop"
    },
    "steps": [
      {
        "id": "song",
        "action": "pretzel.song"
      },
      {
        "action": "chat.send",
        "with": {
          "message": "${steps.song.output.chat}"
        }
      }
    ]
  }
}

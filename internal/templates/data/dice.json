{
  "template": {
    "id": "dice",
    "title": "Roll a die",
    "category": "Chat commands",
    "description": "!roll answers with a random face from 1 to 6.",
    "starter": true,
    "blanks": []
  },
  "workflow": {
    "schema": "streamgremlin.workflow/v1",
    "id": "chat.dice",
    "name": "Roll a die",
    "triggers": [
      {
        "type": "chat.command.received",
        "where": {
          "command": "roll"
        }
      }
    ],
    "queue": {
      "policy": "serial",
      "max_pending": 5
    },
    "steps": [
      {
        "choose": [
          {
            "weight": 1,
            "steps": [
              {
                "set": {
                  "face": "\"1\""
                }
              }
            ]
          },
          {
            "weight": 1,
            "steps": [
              {
                "set": {
                  "face": "\"2\""
                }
              }
            ]
          },
          {
            "weight": 1,
            "steps": [
              {
                "set": {
                  "face": "\"3\""
                }
              }
            ]
          },
          {
            "weight": 1,
            "steps": [
              {
                "set": {
                  "face": "\"4\""
                }
              }
            ]
          },
          {
            "weight": 1,
            "steps": [
              {
                "set": {
                  "face": "\"5\""
                }
              }
            ]
          },
          {
            "weight": 1,
            "steps": [
              {
                "set": {
                  "face": "\"6\""
                }
              }
            ]
          }
        ]
      },
      {
        "action": "chat.send",
        "with": {
          "message": "🎲 ${event.actor.display_name} rolled a ${vars.face}"
        }
      }
    ]
  }
}
